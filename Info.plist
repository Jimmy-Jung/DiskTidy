<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>DiskTidy</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSUIElement</key>
    <true/>
    <key>CFBundleIdentifier</key>
    <string>com.jimmy.disktidy</string>
    <key>CFBundleName</key>
    <string>DiskTidy</string>
    <key>CFBundleDisplayName</key>
    <string>DiskTidy</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.5.0</string>
    <key>CFBundleVersion</key>
    <string>7</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 JunyoungJung. MIT License.</string>
    <!-- TCC 프롬프트에 표시되는 이유 문구. 없으면 macOS가 이유 없이 권한을 묻고
         사용자가 거부한다. 대용량 파일 탭 기본 루트가 ~/Downloads라 첫 실행에 뜬다. -->
    <key>NSDownloadsFolderUsageDescription</key>
    <string>다운로드 폴더의 대용량 파일을 찾아 정리하기 위해 접근 권한이 필요합니다.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>선택한 프로젝트 폴더의 빌드 캐시를 찾아 정리하기 위해 접근 권한이 필요합니다.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>데스크탑을 스캔 대상으로 지정한 경우 대용량 파일을 찾기 위해 접근 권한이 필요합니다.</string>
    <!-- OpenAI 호환 제공자를 로컬 모델 서버(http://localhost:*)로 가리킬 수 있다.
         ATS 전체를 열지 않고 로컬 네트워킹만 허용한다. 원격 평문 http는
         AIRequestBuilder가 따로 막는다. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
